<Window
    x:Class="ScanFolderToFile.App.PrintPreviewWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="940"
    Height="720"
    MinWidth="840"
    MinHeight="620"
    Background="#F4F1EA"
    RequestedThemeVariant="Light"
    Icon="/Assets/Deleket-Sleek-Xp-Basic-Files.ico">
  <Grid Margin="22" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
    <Border Grid.Row="0" Padding="18" Background="#173F35" CornerRadius="18">
      <TextBlock x:Name="PrintPreviewSummaryTextBlock" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#F8F6F1" />
    </Border>

    <Border Grid.Row="1" Padding="16,14" Background="#FFFDF8" BorderBrush="#D7CFBE" BorderThickness="1" CornerRadius="18">
      <TextBlock x:Name="PrintPreviewStatusTextBlock" FontSize="14" TextWrapping="Wrap" Foreground="#4F5A57" />
    </Border>

    <Border Grid.Row="2" Padding="18" Background="#FFFDF8" BorderBrush="#D7CFBE" BorderThickness="1" CornerRadius="18">
      <TextBox
          x:Name="PrintPreviewTextBox"
          IsReadOnly="True"
          AcceptsReturn="True"
          TextWrapping="Wrap"
          VerticalContentAlignment="Top"
          Background="#F7F3EA"
          BorderThickness="0" />
    </Border>

    <Border Grid.Row="3" Padding="18" Background="#FFFDF8" BorderBrush="#D7CFBE" BorderThickness="1" CornerRadius="18">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button x:Name="PrintPreviewPrintButton" Height="42" MinWidth="120" Background="#D98E04" Foreground="#FFF9EE" FontWeight="SemiBold" />
        <Button x:Name="PrintPreviewOpenFileButton" Height="42" MinWidth="130" Background="#173F35" Foreground="#F8F6F1" />
        <Button x:Name="PrintPreviewCloseButton" Height="42" MinWidth="120" Background="#173F35" Foreground="#F8F6F1" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
