<Window
    x:Class="ScanFolderToFile.App.EditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="980"
    Height="760"
    MinWidth="860"
    MinHeight="640"
    RequestedThemeVariant="Light"
    Icon="/Assets/Deleket-Sleek-Xp-Basic-Files.ico">
  <Grid Margin="22" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
    <Border Grid.Row="0" Padding="18" Classes="hero-card">
      <TextBlock x:Name="EditorPathTextBlock" Classes="section-title" FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource HeroForegroundBrush}" />
    </Border>

    <Border Grid.Row="1" Padding="16,14" Classes="card">
      <TextBlock x:Name="EditorStatusTextBlock" Classes="body-copy" />
    </Border>

    <Border Grid.Row="2" Padding="18" Classes="card">
      <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
        <Button x:Name="EditorOpenButton" Grid.Column="0" Classes="secondary" />
        <Button x:Name="EditorSaveButton" Grid.Column="1" Classes="primary" />
        <Button x:Name="EditorSaveAsButton" Grid.Column="2" Classes="secondary" />
        <Button x:Name="EditorPrintPreviewButton" Grid.Column="3" Classes="secondary" />
        <Button x:Name="EditorCloseButton" Grid.Column="4" Classes="tertiary" />
      </Grid>
    </Border>

    <Border Grid.Row="3" Padding="18" Classes="card">
      <TextBox
          x:Name="EditorTextBox"
          Classes="surface"
          AcceptsReturn="True"
          TextWrapping="Wrap"
          VerticalContentAlignment="Top"
          BorderThickness="0" />
    </Border>
  </Grid>
</Window>
