<Window
    x:Class="ScanFolderToFile.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1180"
    Height="820"
    MinWidth="1024"
    MinHeight="760"
    RequestedThemeVariant="Light"
    Icon="/Assets/Deleket-Sleek-Xp-Basic-Files.ico">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="18">
      <Border Grid.Row="0" Padding="24" Classes="hero-card" CornerRadius="20">
        <StackPanel Spacing="8">
          <TextBlock x:Name="HeaderTitleTextBlock" Classes="hero-title" />
          <TextBlock x:Name="HeaderSubtitleTextBlock" Classes="hero-subtitle" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Padding="16,14" Classes="card">
        <StackPanel Spacing="8">
          <TextBlock x:Name="StatusTitleTextBlock" Classes="section-title" />
          <TextBlock x:Name="StatusTextBlock" Classes="body-copy" />
        </StackPanel>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="1.05*,0.95*" ColumnSpacing="18">
        <StackPanel Grid.Column="0" Spacing="18">
          <Border Padding="20" Classes="card">
            <Grid ColumnDefinitions="124,*,132" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
              <TextBlock x:Name="SourceFolderLabelTextBlock" Grid.Row="0" Grid.Column="0" Classes="field-label" VerticalAlignment="Center" />
              <TextBox x:Name="SourceFolderTextBox" Grid.Row="0" Grid.Column="1" Classes="surface" />
              <Button x:Name="BrowseSourceButton" Grid.Row="0" Grid.Column="2" Classes="secondary" Width="132" />

              <TextBlock x:Name="OutputFolderLabelTextBlock" Grid.Row="1" Grid.Column="0" Classes="field-label" VerticalAlignment="Center" />
              <TextBox x:Name="OutputFolderTextBox" Grid.Row="1" Grid.Column="1" Classes="surface" />
              <Button x:Name="BrowseOutputButton" Grid.Row="1" Grid.Column="2" Classes="secondary" Width="132" />
            </Grid>
          </Border>

          <Border Padding="20" Classes="card">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="124,*" ColumnSpacing="12">
                <TextBlock x:Name="OutputFormatLabelTextBlock" Grid.Column="0" Classes="field-label" VerticalAlignment="Center" />
                <ComboBox x:Name="OutputFormatComboBox" Grid.Column="1" Classes="surface" />
              </Grid>

              <Grid ColumnDefinitions="1.1*,1*,1.2*" ColumnSpacing="16">
                <CheckBox x:Name="OnlyExtensionsCheckBox" Grid.Column="0" />
                <CheckBox x:Name="CreateZipCheckBox" Grid.Column="1" />
                <CheckBox x:Name="CollectDuplicatesCheckBox" Grid.Column="2" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Padding="20" Classes="card">
            <StackPanel Spacing="10">
              <TextBlock x:Name="FilterSummaryTitleTextBlock" Classes="section-title" />
              <TextBlock x:Name="FilterSummaryTextBlock" Classes="body-copy" />
            </StackPanel>
          </Border>

          <Border Padding="20" Classes="card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Button x:Name="GenerateButton" Grid.Column="0" Classes="primary" />
                <Button x:Name="OpenGeneratedFileButton" Grid.Column="1" Classes="secondary" />
                <Button x:Name="OpenOutputFolderButton" Grid.Column="2" Classes="secondary" />
                <Button x:Name="OpenFiltersButton" Grid.Column="3" Classes="secondary" />
              </Grid>

              <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                <Button x:Name="OpenHistoryButton" Grid.Column="0" Classes="secondary" />
                <Button x:Name="OpenDuplicatesButton" Grid.Column="1" Classes="secondary" />
                <Button x:Name="OpenUtilitiesButton" Grid.Column="2" Classes="secondary" />
                <Button x:Name="OpenEditorButton" Grid.Column="3" Classes="secondary" />
                <Button x:Name="OpenPrintPreviewButton" Grid.Column="4" Classes="secondary" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="18">
          <Border Padding="18" Classes="card">
            <StackPanel Spacing="10">
              <TextBlock x:Name="ResultTitleTextBlock" Classes="section-title" />
              <TextBlock x:Name="ResultSummaryTextBlock" Classes="body-copy" />
            </StackPanel>
          </Border>

          <Border Padding="18" Classes="card">
            <StackPanel Spacing="10">
              <TextBlock x:Name="PreviewTitleTextBlock" Classes="section-title" />
              <TextBox
                  x:Name="PreviewTextBox"
                  Classes="surface"
                  Height="500"
                  IsReadOnly="True"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  VerticalContentAlignment="Top"
                  BorderThickness="0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </ScrollViewer>
</Window>
