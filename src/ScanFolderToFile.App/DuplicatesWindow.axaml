<Window
    x:Class="ScanFolderToFile.App.DuplicatesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="860"
    Height="620"
    MinWidth="760"
    MinHeight="520"
    RequestedThemeVariant="Light"
    Icon="/Assets/Deleket-Sleek-Xp-Basic-Files.ico">
  <Grid Margin="22" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
    <Border Grid.Row="0" Padding="18" Classes="hero-card">
      <TextBlock x:Name="DuplicatesSummaryTextBlock" Classes="section-title" Foreground="{DynamicResource HeroForegroundBrush}" />
    </Border>

    <Border Grid.Row="1" Padding="16,14" Classes="card">
      <TextBlock x:Name="DuplicatesStatusTextBlock" Classes="body-copy" />
    </Border>

    <Border Grid.Row="2" Padding="18" Classes="card">
      <Grid RowDefinitions="*,Auto" RowSpacing="14">
        <ListBox x:Name="DuplicatesListBox" Grid.Row="0" Classes="surface">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4" Spacing="2">
                <TextBlock Text="{Binding DisplayText}" Classes="field-label" />
                <TextBlock Text="{Binding FilePath}" Classes="subtle-copy" FontSize="12" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="DuplicatesEmptyTextBlock" Grid.Row="0" IsVisible="False" Classes="body-copy" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
          <Button x:Name="DuplicatesOpenFileButton" Grid.Column="0" Classes="secondary" />
          <Button x:Name="DuplicatesOpenFolderButton" Grid.Column="1" Classes="secondary" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
