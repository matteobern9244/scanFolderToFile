<Window
    x:Class="ScanFolderToFile.App.UtilitiesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="900"
    Height="700"
    MinWidth="820"
    MinHeight="620"
    RequestedThemeVariant="Light"
    Icon="/Assets/Deleket-Sleek-Xp-Basic-Files.ico">
  <Grid Margin="22" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="16">
    <Border Grid.Row="0" Padding="18" Classes="hero-card">
      <StackPanel Spacing="10">
        <TextBlock x:Name="UtilitiesModeLabelTextBlock" Classes="section-title" Foreground="{DynamicResource HeroForegroundBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="18">
          <RadioButton x:Name="UtilityCopyRadioButton" Classes="hero-toggle" />
          <RadioButton x:Name="UtilityMoveRadioButton" Classes="hero-toggle" />
          <RadioButton x:Name="UtilityReorderRadioButton" Classes="hero-toggle" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Padding="18" Classes="card">
      <Grid ColumnDefinitions="132,*,152" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
        <TextBlock x:Name="UtilitySourceLabelTextBlock" Grid.Row="0" Grid.Column="0" Classes="field-label" VerticalAlignment="Center" />
        <TextBox x:Name="UtilitySourceTextBox" Grid.Row="0" Grid.Column="1" Classes="surface" />
        <Button x:Name="UtilityBrowseSourceButton" Grid.Row="0" Grid.Column="2" Classes="secondary" Width="152" />

        <TextBlock x:Name="UtilityDestinationLabelTextBlock" Grid.Row="1" Grid.Column="0" Classes="field-label" VerticalAlignment="Center" />
        <TextBox x:Name="UtilityDestinationTextBox" Grid.Row="1" Grid.Column="1" Classes="surface" />
        <Button x:Name="UtilityBrowseDestinationButton" Grid.Row="1" Grid.Column="2" Classes="secondary" Width="152" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Padding="16,14" Classes="card">
      <TextBlock x:Name="UtilityStatusTextBlock" Classes="body-copy" />
    </Border>

    <Border Grid.Row="3" Padding="18" Classes="card">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Button x:Name="UtilityExecuteButton" Grid.Column="0" Classes="primary" />
        <Button x:Name="UtilityCloseButton" Grid.Column="1" Classes="secondary" />
      </Grid>
    </Border>

    <Border Grid.Row="4" Padding="18" Classes="card">
      <TextBox
          x:Name="UtilityResultTextBox"
          Classes="surface"
          IsReadOnly="True"
          AcceptsReturn="True"
          TextWrapping="Wrap"
          VerticalContentAlignment="Top"
          BorderThickness="0" />
    </Border>
  </Grid>
</Window>
