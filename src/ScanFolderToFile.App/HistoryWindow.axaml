<Window
    x:Class="ScanFolderToFile.App.HistoryWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="760"
    Height="520"
    MinWidth="760"
    MinHeight="520"
    Background="#F4F1EA"
    RequestedThemeVariant="Light"
    Icon="/Assets/Deleket-Sleek-Xp-Basic-Files.ico">
  <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
    <Border Grid.Row="0" Padding="14,12" Background="#FFFDF8" BorderBrush="#D7CFBE" BorderThickness="1" CornerRadius="14">
      <TextBlock x:Name="HistoryStatusTextBlock" FontSize="13" TextWrapping="Wrap" Foreground="#4F5A57" />
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
      <Button x:Name="HistoryOpenButton" Grid.Column="0" Height="40" MinWidth="110" Background="#173F35" Foreground="#F8F6F1" />
      <Button x:Name="HistoryOpenFolderButton" Grid.Column="1" Height="40" MinWidth="150" Background="#173F35" Foreground="#F8F6F1" />
      <Button x:Name="HistoryRefreshButton" Grid.Column="2" Height="40" MinWidth="110" HorizontalAlignment="Right" Background="#D98E04" Foreground="#FFF9EE" FontWeight="SemiBold" />
    </Grid>

    <Border Grid.Row="2" Padding="8" Background="#FFFDF8" BorderBrush="#D7CFBE" BorderThickness="1" CornerRadius="14">
      <ListBox x:Name="HistoryListBox" Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="2.2*,0.8*,1.4*,0.8*" ColumnSpacing="10" Margin="4,6">
              <TextBlock Grid.Column="0" Text="{Binding FileName}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{Binding Extension}" />
              <TextBlock Grid.Column="2" Text="{Binding CreatedAtDisplay}" />
              <TextBlock Grid.Column="3" Text="{Binding ExistsLabel}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Border Grid.Row="3" Padding="12,10" Background="#E7E0D0" CornerRadius="14">
      <Grid ColumnDefinitions="2.2*,0.8*,1.4*,0.8*" ColumnSpacing="10">
        <TextBlock x:Name="HistoryNameHeaderTextBlock" Grid.Column="0" FontWeight="SemiBold" Foreground="#5F5B52" />
        <TextBlock x:Name="HistoryExtensionHeaderTextBlock" Grid.Column="1" FontWeight="SemiBold" Foreground="#5F5B52" />
        <TextBlock x:Name="HistoryCreatedAtHeaderTextBlock" Grid.Column="2" FontWeight="SemiBold" Foreground="#5F5B52" />
        <TextBlock x:Name="HistoryStateHeaderTextBlock" Grid.Column="3" FontWeight="SemiBold" Foreground="#5F5B52" />
      </Grid>
    </Border>
  </Grid>
</Window>
