<Window
    x:Class="ScanFolderToFile.App.FilterWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="560"
    Height="420"
    MinWidth="560"
    MinHeight="420"
    CanResize="False"
    RequestedThemeVariant="Light"
    Icon="/Assets/Deleket-Sleek-Xp-Basic-Files.ico">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="16">
    <TextBlock x:Name="FilterWindowModeLabelTextBlock" Grid.Row="0" Classes="section-title" />

    <StackPanel Grid.Row="1" Spacing="10">
      <RadioButton x:Name="FilterNoneRadioButton" GroupName="FilterMode" />
      <RadioButton x:Name="FilterSizeRadioButton" GroupName="FilterMode" />
      <RadioButton x:Name="FilterDateRadioButton" GroupName="FilterMode" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="112,*,112,*" ColumnSpacing="12" RowSpacing="10">
      <TextBlock x:Name="FilterMinSizeLabelTextBlock" Grid.Column="0" Classes="field-label" VerticalAlignment="Center" />
      <TextBox x:Name="FilterMinSizeTextBox" Grid.Column="1" Classes="surface" />
      <TextBlock x:Name="FilterMaxSizeLabelTextBlock" Grid.Column="2" Classes="field-label" VerticalAlignment="Center" />
      <TextBox x:Name="FilterMaxSizeTextBox" Grid.Column="3" Classes="surface" />
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="112,*,112,*" ColumnSpacing="12" RowSpacing="10">
      <TextBlock x:Name="FilterStartDateLabelTextBlock" Grid.Column="0" Classes="field-label" VerticalAlignment="Center" />
      <TextBox x:Name="FilterStartDateTextBox" Grid.Column="1" Classes="surface" />
      <TextBlock x:Name="FilterEndDateLabelTextBlock" Grid.Column="2" Classes="field-label" VerticalAlignment="Center" />
      <TextBox x:Name="FilterEndDateTextBox" Grid.Column="3" Classes="surface" />
    </Grid>

    <Grid Grid.Row="4" RowDefinitions="Auto,*,Auto" RowSpacing="12">
      <TextBlock x:Name="FilterDateHintTextBlock" Grid.Row="0" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource MutedForegroundBrush}" />
      <Border Grid.Row="1" Padding="14,12" Classes="card" CornerRadius="14">
        <TextBlock x:Name="FilterStatusTextBlock" Classes="subtle-copy" />
      </Border>
      <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="12">
        <Button x:Name="FilterApplyButton" Grid.Column="0" Classes="primary" />
        <Button x:Name="FilterClearButton" Grid.Column="1" Classes="secondary" />
        <Button x:Name="FilterCancelButton" Grid.Column="2" Classes="tertiary" />
      </Grid>
    </Grid>
  </Grid>
</Window>
