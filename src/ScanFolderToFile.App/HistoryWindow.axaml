<Window
    x:Class="ScanFolderToFile.App.HistoryWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="760"
    Height="520"
    MinWidth="760"
    MinHeight="520"
    RequestedThemeVariant="Light"
    Icon="/Assets/Deleket-Sleek-Xp-Basic-Files.ico">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
    <Border Grid.Row="0" Padding="14,12" Classes="card" CornerRadius="14">
      <TextBlock x:Name="HistoryStatusTextBlock" Classes="subtle-copy" />
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
      <Button x:Name="HistoryOpenButton" Grid.Column="0" Classes="secondary" />
      <Button x:Name="HistoryOpenFolderButton" Grid.Column="1" Classes="secondary" />
      <Button x:Name="HistoryRefreshButton" Grid.Column="2" Classes="primary" />
    </Grid>

    <Border Grid.Row="2" Padding="12,10" Classes="footer-card">
      <Grid ColumnDefinitions="2.2*,0.8*,1.4*,0.8*" ColumnSpacing="10">
        <TextBlock x:Name="HistoryNameHeaderTextBlock" Grid.Column="0" Classes="footer-copy" />
        <TextBlock x:Name="HistoryExtensionHeaderTextBlock" Grid.Column="1" Classes="footer-copy" />
        <TextBlock x:Name="HistoryCreatedAtHeaderTextBlock" Grid.Column="2" Classes="footer-copy" />
        <TextBlock x:Name="HistoryStateHeaderTextBlock" Grid.Column="3" Classes="footer-copy" />
      </Grid>
    </Border>

    <Border Grid.Row="3" Padding="8" Classes="card" CornerRadius="14">
      <ListBox x:Name="HistoryListBox" Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="2.2*,0.8*,1.4*,0.8*" ColumnSpacing="10" Margin="4,6">
              <TextBlock Grid.Column="0" Text="{Binding FileName}" Classes="body-copy" />
              <TextBlock Grid.Column="1" Text="{Binding Extension}" Classes="body-copy" />
              <TextBlock Grid.Column="2" Text="{Binding CreatedAtDisplay}" Classes="body-copy" />
              <TextBlock Grid.Column="3" Text="{Binding ExistsLabel}" Classes="body-copy" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</Window>
