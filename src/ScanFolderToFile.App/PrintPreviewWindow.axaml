<Window
    x:Class="ScanFolderToFile.App.PrintPreviewWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="940"
    Height="720"
    MinWidth="840"
    MinHeight="620"
    RequestedThemeVariant="Light"
    Icon="/Assets/Deleket-Sleek-Xp-Basic-Files.ico">
  <Grid Margin="22" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
    <Border Grid.Row="0" Padding="18" Classes="hero-card">
      <TextBlock x:Name="PrintPreviewSummaryTextBlock" Classes="section-title" FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource HeroForegroundBrush}" />
    </Border>

    <Border Grid.Row="1" Padding="16,14" Classes="card">
      <TextBlock x:Name="PrintPreviewStatusTextBlock" Classes="body-copy" />
    </Border>

    <Border Grid.Row="2" Padding="18" Classes="card">
      <TextBox
          x:Name="PrintPreviewTextBox"
          Classes="surface"
          IsReadOnly="True"
          AcceptsReturn="True"
          TextWrapping="Wrap"
          VerticalContentAlignment="Top"
          BorderThickness="0" />
    </Border>

    <Border Grid.Row="3" Padding="18" Classes="card">
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
        <Button x:Name="PrintPreviewPrintButton" Grid.Column="0" Classes="primary" />
        <Button x:Name="PrintPreviewOpenFileButton" Grid.Column="1" Classes="secondary" />
        <Button x:Name="PrintPreviewCloseButton" Grid.Column="2" Classes="tertiary" />
      </Grid>
    </Border>
  </Grid>
</Window>
