<Window
    x:Class="ScanFolderToFile.App.DuplicatesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="860"
    Height="620"
    MinWidth="760"
    MinHeight="520"
    Background="#F4F1EA"
    RequestedThemeVariant="Light"
    Icon="/Assets/Deleket-Sleek-Xp-Basic-Files.ico">
  <Grid Margin="22" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
    <Border Grid.Row="0" Padding="18" Background="#173F35" CornerRadius="18">
      <TextBlock x:Name="DuplicatesSummaryTextBlock" FontSize="18" FontWeight="SemiBold" Foreground="#F8F6F1" />
    </Border>

    <Border Grid.Row="1" Padding="16,14" Background="#FFFDF8" BorderBrush="#D7CFBE" BorderThickness="1" CornerRadius="18">
      <TextBlock x:Name="DuplicatesStatusTextBlock" FontSize="14" TextWrapping="Wrap" Foreground="#4F5A57" />
    </Border>

    <Border Grid.Row="2" Padding="18" Background="#FFFDF8" BorderBrush="#D7CFBE" BorderThickness="1" CornerRadius="18">
      <Grid RowDefinitions="*,Auto" RowSpacing="14">
        <ListBox x:Name="DuplicatesListBox" Grid.Row="0" Background="#F7F3EA" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4" Spacing="2">
                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" Foreground="#173F35" />
                <TextBlock Text="{Binding FilePath}" FontSize="12" TextWrapping="Wrap" Foreground="#4F5A57" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="DuplicatesEmptyTextBlock" Grid.Row="0" IsVisible="False" FontSize="14" TextWrapping="Wrap" Foreground="#4F5A57" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
          <Button x:Name="DuplicatesOpenFileButton" Height="42" MinWidth="130" Background="#173F35" Foreground="#F8F6F1" />
          <Button x:Name="DuplicatesOpenFolderButton" Height="42" MinWidth="140" Background="#173F35" Foreground="#F8F6F1" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
