<Window
    x:Class="ScanFolderToFile.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="720"
    Height="420"
    MinWidth="720"
    MinHeight="420"
    Background="#F4F1EA"
    RequestedThemeVariant="Light"
    Icon="/Assets/Deleket-Sleek-Xp-Basic-Files.ico">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="18">
    <Border Grid.Row="0" Padding="24" Background="#173F35" CornerRadius="20">
      <StackPanel Spacing="8">
        <TextBlock x:Name="HeadlineTextBlock" FontSize="30" FontWeight="Bold" Foreground="#F8F6F1" />
        <TextBlock x:Name="SubheadlineTextBlock" FontSize="14" TextWrapping="Wrap" Foreground="#D7E7DC" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="*,*" ColumnSpacing="18" RowSpacing="18">
      <Border Grid.Row="0" Grid.Column="0" Padding="20" Background="#FFFDF8" BorderBrush="#D7CFBE" BorderThickness="1" CornerRadius="18">
        <StackPanel Spacing="10">
          <TextBlock x:Name="CoreTitleTextBlock" FontSize="20" FontWeight="SemiBold" Foreground="#173F35" />
          <TextBlock x:Name="CoreBodyTextBlock" FontSize="14" TextWrapping="Wrap" Foreground="#4F5A57" />
        </StackPanel>
      </Border>

      <Border Grid.Row="0" Grid.Column="1" Padding="20" Background="#FFFDF8" BorderBrush="#D7CFBE" BorderThickness="1" CornerRadius="18">
        <StackPanel Spacing="10">
          <TextBlock x:Name="LauncherTitleTextBlock" FontSize="20" FontWeight="SemiBold" Foreground="#173F35" />
          <TextBlock x:Name="LauncherBodyTextBlock" FontSize="14" TextWrapping="Wrap" Foreground="#4F5A57" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Padding="20" Background="#D98E04" CornerRadius="18">
        <StackPanel Spacing="10">
          <TextBlock x:Name="CiTitleTextBlock" FontSize="20" FontWeight="SemiBold" Foreground="#FFF9EE" />
          <TextBlock x:Name="CiBodyTextBlock" FontSize="14" TextWrapping="Wrap" Foreground="#FFF2D6" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Padding="16,12" Background="#E7E0D0" CornerRadius="16">
      <TextBlock x:Name="FooterTextBlock" FontSize="13" FontWeight="Medium" Foreground="#5F5B52" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
